DATABASE_URL=sqlite:///./app.db
CORS_ORIGINS=http://localhost:5173,http://35.237.89.149

# ComfyUI 이미지 생성 서버(nginx Basic Auth 뒤) — 비워두면 그림이 만들어지지 않고 칸이 failed로 남는다.
COMFY_BASE_URL=http://35.237.89.149/comfy
COMFY_USER=changeme
COMFY_PASSWORD=changeme
# app/services/workflows/ 밑의 파일명 — 기본값(character_practice.json) 그대로면 생략 가능
# COMFY_WORKFLOW_FILE=character_practice.json
# 생성 PNG 저장 폴더(backend/ 기준 상대경로 또는 절대경로). /api/media/<파일명>으로 서빙. 기본 media
# MEDIA_DIR=media

# 캐릭터 설명(한국어)을 Danbooru 태그로 바꾸는 GPT. 비우면 화이트리스트 → 원문 순으로 폴백한다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 트렌드 화면 밈 추천(meme_recommend)만 위 OPENAI_MODEL과 별도로 쓰는 모델.
# OPENAI_MEME_MODEL=gpt-5-mini
# 태그 실존·게시물수 검증용 parquet(README "태그 검증용 parquet 준비"). backend/ 기준 상대경로 또는 절대경로.
# DANBOORU_TAGS_PATH=data/danbooru_tags/danbooru.donmai.us/tags.parquet

# 인스타그램 자동 게시 — 셋 다 있어야 결과 화면에 '인스타에 올리기' 버튼이 뜬다.
# 비즈니스 계정 전환 → Meta 앱 생성 → Instagram API with Instagram Login 추가 →
# 내 계정을 Instagram 테스터로 등록 → 액세스 토큰 발급.
# 토큰은 60일짜리이고, 만료 20일 전부터 서비스가 알아서 갱신한다(다시 받을 일 없음).
# 연결은 화면(설정 → 인스타그램 계정 연결)에서 토큰만 넣으면 되고, 사용자 ID 는 서버가 조회한다.
# 아래 두 값은 화면을 쓰지 않고 .env 로만 붙일 때의 폴백이다.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# 인스타 서버가 직접 열 수 있는 우리 서버 주소. localhost 는 인스타가 못 연다(로컬 테스트 불가).
PUBLIC_BASE_URL=http://35.237.89.149
# API 버전을 바꿔야 할 때만. 기본 https://graph.instagram.com/v21.0
# INSTAGRAM_API_BASE=https://graph.instagram.com/v21.0
